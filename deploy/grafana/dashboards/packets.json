{
  "annotations": {
    "list": []
  },
  "description": "Each series once: source IP first, dest only if source did not match. Port is src or dst the same way. .* still works if src_port was dropped. Bytes are skb->len (L2 included).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Traffic timeline",
      "type": "link",
      "url": "/d/packet-timeline"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Top flows. IP and port match src, then dest-only.",
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "topk(40, sum by (interface, src_ip, dst_ip, src_port, dst_port, type) (rate((((packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",src_ip=~\"$ip\"} or packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",dst_ip=~\"$ip\",src_ip!~\"$ip\"}) unless packet_total{src_port=~\".+\"} unless packet_total{dst_port=~\".+\"}) or (packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",src_ip=~\"$ip\",src_port=~\"$port\"} or packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",src_ip=~\"$ip\",dst_port=~\"$port\",src_port!~\"$port\"} or packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",dst_ip=~\"$ip\",src_ip!~\"$ip\",src_port=~\"$port\"} or packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",dst_ip=~\"$ip\",src_ip!~\"$ip\",dst_port=~\"$port\",src_port!~\"$port\"}) or ((packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",src_ip=~\"$ip\",dst_port=~\"$port\"} or packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",dst_ip=~\"$ip\",src_ip!~\"$ip\",dst_port=~\"$port\"}) unless packet_total{src_port=~\".+\"}))[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{type}} {{src_ip}}:{{src_port}} -> {{dst_ip}}:{{dst_port}}"
        }
      ],
      "title": "Packet rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "skb->len, including Ethernet.",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "topk(40, sum by (interface, src_ip, dst_ip, src_port, dst_port, type) (rate((((packet_bytes_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",src_ip=~\"$ip\"} or packet_bytes_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",dst_ip=~\"$ip\",src_ip!~\"$ip\"}) unless packet_bytes_total{src_port=~\".+\"} unless packet_bytes_total{dst_port=~\".+\"}) or (packet_bytes_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",src_ip=~\"$ip\",src_port=~\"$port\"} or packet_bytes_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",src_ip=~\"$ip\",dst_port=~\"$port\",src_port!~\"$port\"} or packet_bytes_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",dst_ip=~\"$ip\",src_ip!~\"$ip\",src_port=~\"$port\"} or packet_bytes_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",dst_ip=~\"$ip\",src_ip!~\"$ip\",dst_port=~\"$port\",src_port!~\"$port\"}) or ((packet_bytes_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",src_ip=~\"$ip\",dst_port=~\"$port\"} or packet_bytes_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",dst_ip=~\"$ip\",src_ip!~\"$ip\",dst_port=~\"$port\"}) unless packet_bytes_total{src_port=~\".+\"}))[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{type}} {{src_ip}}:{{src_port}} -> {{dst_ip}}:{{dst_port}}"
        }
      ],
      "title": "Byte rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "SYN, SYN-ACK, ACK/data, FIN, RST, UDP, ICMP.",
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 75,
            "showPoints": "never",
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^syn( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#F2CC0C",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^synack( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#FF9830",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^ack( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#73BF69",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^fin( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#5794F2",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^rst( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#F2495C",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^udp( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#B877D9",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^icmp( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#6ED0E0",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (type) (rate((((packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",src_ip=~\"$ip\"} or packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",dst_ip=~\"$ip\",src_ip!~\"$ip\"}) unless packet_total{src_port=~\".+\"} unless packet_total{dst_port=~\".+\"}) or (packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",src_ip=~\"$ip\",src_port=~\"$port\"} or packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",src_ip=~\"$ip\",dst_port=~\"$port\",src_port!~\"$port\"} or packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",dst_ip=~\"$ip\",src_ip!~\"$ip\",src_port=~\"$port\"} or packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",dst_ip=~\"$ip\",src_ip!~\"$ip\",dst_port=~\"$port\",src_port!~\"$port\"}) or ((packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",src_ip=~\"$ip\",dst_port=~\"$port\"} or packet_total{interface=~\"${iface:regex}\",type=~\"${type:regex}\",dst_ip=~\"$ip\",src_ip!~\"$ip\",dst_port=~\"$port\"}) unless packet_total{src_port=~\".+\"}))[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{type}}"
        }
      ],
      "title": "Packets by type",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
